{
  "name": "pi-minimal-tools-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal, aggregated tool views for Pi with clickable per-block details.",
  "keywords": [
    "pi-package"
  ],
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VinhLe1410/pi-minimal-tools-view.git"
  },
  "homepage": "https://github.com/VinhLe1410/pi-minimal-tools-view",
  "bugs": {
    "url": "https://github.com/VinhLe1410/pi-minimal-tools-view/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
